                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.80"
                    
                    android:text="10"
                    android:gravity="left"
                    android:textAppearance="?android:attr/textAppearanceSmall" />
                        
            </TableRow>
                            
