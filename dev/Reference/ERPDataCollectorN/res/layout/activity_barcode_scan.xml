<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" >
<LinearLayout 
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#fff"
    android:orientation="vertical" >

    <ImageView
        android:id="@+id/imageView1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:src="@drawable/logobrand2" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Scan Barcode / QR"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textColor="#0099ff" />

          <EditText
              android:id="@+id/txtbar"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:ems="10"
              android:singleLine="true"
              android:layout_marginTop="2dp"
              android:background="@drawable/text_view_shape" >

       <requestFocus />
       </EditText>
       
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.01" >

      <TableLayout
              android:id="@+id/l1ao"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:background="#ffffff"
              android:stretchColumns="0,1" >
              
          
          
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewId"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".30"
		               android:gravity="left"
		               android:text="Id:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

		           	<TextView
		               android:id="@+id/tvPhyDetID2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".70"
		               android:text="1"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" />
		           		           

               </TableRow>           
          
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewReff"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".30"
		               android:gravity="left"
		               android:text="Reference:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

		           	<TextView
		               android:id="@+id/tvReference2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".70"
		               android:text="1"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" />
		           		           

               </TableRow>           
          
			 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textView2"
		               android:layout_width="wrap_content"
		               android:layout_height="wrap_content"
		               android:layout_weight="1"
		               android:layout_span="2" 
		               android:text="Description:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"/>

               </TableRow>       
                
                 <TableRow android:layout_weight="1"
                     android:paddingTop="4dp">
		           <TextView
		               
		               android:id="@+id/tvDescrption2"
		               android:layout_width="fill_parent"
		               android:layout_height="60dp"
		               android:layout_weight="1"
		               android:layout_span="2" 
		               android:text="Description"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" 
		               />

               </TableRow>                                    
              
               <TableRow  android:layout_weight="1" android:background="#efefef">
				   <TextView android:layout_span="2" 
				       android:layout_height="1dp" 
				       android:textColor="#0099ff"
		         	   android:text="">
		   		   </TextView>
	   		   </TableRow>   
	   		                    
               
               
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewExp"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".30"
		               android:gravity="left"
		               android:text="Expiry:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

		           	<TextView
		               android:id="@+id/tvExp2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".70"
		               android:text="1"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" />
		           		           

               </TableRow>                
               
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewLot"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".30"
		               android:gravity="left"
		               android:text="Lot:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

		           	<TextView
		               android:id="@+id/tvLot2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".70"
		               android:text="1"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" />
		           		           

               </TableRow>                   
                 
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewAvlbQty"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".30"
		               android:gravity="left"
		               android:text="Avlb Qty:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

		           	<TextView
		               android:id="@+id/tvAvlbQty2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".70"
		               android:text="1"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#000" />
		           		           

               </TableRow>                    
         
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewTotalCounted"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".50"
		               android:gravity="left"
		               android:text="Total Qty Scanned:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />


                   <EditText
                       android:id="@+id/tvTotalScannedt"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".50"
		               android:text="1"
		               android:textColor="#000"
              		   android:ems="10"
                       android:singleLine="true"
                       android:inputType="number"
					   android:background="@drawable/text_view_shape">

                    </EditText>			           		           

               </TableRow>    
                         
               <TableRow  android:layout_weight="1" 
                   android:background="#efefef"
                   android:paddingTop="10dp" >

		   		           <Button
            android:id="@+id/btn_SaveTotalCounted"
            android:layout_span="2" 
            android:layout_height="wrap_content"
            android:text="Update Total Scanned" />
	   		   </TableRow> 
	   		                    
               <TableRow  android:layout_weight="1" 
                   android:background="#efefef"
                    android:paddingTop="10dp" >
				   <TextView android:layout_span="2" 
				       android:layout_height="1dp" 
				       android:textColor="#0099ff"
		         	   android:text="">
		   		   </TextView>
	   		   </TableRow>   
	   		   
                 <TableRow android:layout_weight="1"
                    android:paddingTop="4dp">
		           <TextView
		               android:id="@+id/textViewScannedQty"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".50"
		               android:gravity="left"
		               android:text="Last Scanned:"
		               android:textAppearance="?android:attr/textAppearanceMedium" 
		               android:textColor="#0099ff"
		              />

                   <EditText
                       android:id="@+id/tvCountedQty2"
		               android:layout_width="0dp"
		               android:layout_height="wrap_content"
		               android:layout_weight=".50"
		               android:text="1"
		               android:textColor="#000"
              		   android:ems="10"
                       android:singleLine="true"
                       android:inputType="number"
					   android:background="@drawable/text_view_shape">

                    </EditText>		           
		           

               </TableRow>                 
                 
               <TableRow  android:layout_weight="1" android:background="#efefef">
				   <TextView android:layout_span="2" 
				       android:layout_height="1dp" 
				       android:textColor="#0099ff"
		         	   android:text="">
		   		   </TextView>
	   		   </TableRow>   
	   		                    
                               <TableRow  android:layout_weight="1" 
                   android:background="#efefef"
                   android:paddingTop="10dp" >

		   		           <Button
            android:id="@+id/btn_UpdateLastScan"
            android:layout_span="2" 
            android:layout_height="wrap_content"
            android:text="Update Last Scan Qty" />
	   		   </TableRow> 
                                
              </TableLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="4dp" >


        <Button
            android:id="@+id/btn_CancelLastScan"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="Cancel Last Scan" />
    </LinearLayout>          
</LinearLayout>
</ScrollView>