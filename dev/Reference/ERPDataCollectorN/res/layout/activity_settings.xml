<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true" >

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff" >

        <TableLayout
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:background="#ffffff"
            android:stretchColumns="0,1" >
            
            
            <TableRow
                android:layout_weight="1"
                android:paddingTop="3dp" >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".30"
                    android:gravity="left"
                    android:text="Location:"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0099ff" />

                <EditText
                    android:id="@+id/txtLocation"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_weight=".70"
                    android:ems="10"
                    android:inputType="text"
                    android:maxLength="2"
                    android:background="@drawable/textview_border2"  >
                </EditText>
                                

            </TableRow>
                  
            <TableRow
                android:layout_weight="1"
                android:paddingTop="3dp" >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".30"
                    android:gravity="left"
                    android:text="Server:"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0099ff" />

                <EditText
                    android:id="@+id/txturl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_weight=".70"
                    android:ems="10"
                    android:inputType="text"
                    android:background="@drawable/textview_border2"  >
                </EditText>
                                
                  
            </TableRow>
                        
            <TableRow
                android:layout_weight="1"
                android:paddingTop="3dp" >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".40"
                    android:gravity="left"
                    android:text="Machine Name:"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0099ff" />

                <EditText
                    android:id="@+id/txtMachineName"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_weight=".60"
                    android:ems="10"
                    android:inputType="text"
                    android:background="@drawable/textview_border2"  >
                </EditText>
            </TableRow>
                  
            <TableRow
                android:layout_weight="1"
                android:paddingTop="3dp" >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight=".40"
                    android:gravity="left"
                    android:text="Download size:"
                    android:textAppearance="?android:attr/textAppearanceMedium"
                    android:textColor="#0099ff" />

                <EditText
                    android:id="@+id/txtDownloadPageSize"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_weight=".60"
                    android:ems="10"
                    android:hint="Records/Page"
                    android:inputType="number"
                    android:background="@drawable/textview_border2"  >
                </EditText>
            </TableRow>
                      
             <TableRow
                android:layout_marginTop="3dp"
                android:layout_weight="1" >

                <Button
                    android:id="@+id/btnSelectSettings"
                    android:layout_width="fill_parent"
                    android:layout_height="70dp"
                    android:layout_marginLeft="0dp"
                    android:layout_span="2"
                    android:text="Select Settings"
                    android:textColor="#000" />
            </TableRow>           
   
            <TableRow
                android:layout_marginTop="3dp"
                android:layout_weight="1" >
				<Button
				   android:id="@+id/btnSave"
				   android:layout_width="fill_parent"
				   android:layout_height="70dp"
				   android:text="Save Settings"
				   android:layout_marginLeft="0dp"
				   android:textColor="#000"
				   android:layout_span="2"  />	

                         
            </TableRow>      
            
            <TableRow
                android:layout_marginTop="3dp"
                android:layout_weight="1" >
				<Button
				   android:id="@+id/btnRegenerateUpload"
				   android:layout_width="fill_parent"
				   android:layout_height="70dp"
				   android:text="Restore Uploaded"
				   android:layout_marginLeft="0dp"
				   android:textColor="#000"
				   android:layout_span="2"  />	

                         
            </TableRow> 
            
        </TableLayout>
    </RelativeLayout>

</ScrollView>
