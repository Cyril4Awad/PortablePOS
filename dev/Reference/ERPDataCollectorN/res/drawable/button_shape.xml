<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="false"><shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <corners android:radius="20dp" />

            <gradient android:angle="270" android:centerColor="#C7C7C7" android:centerX="50%" android:endColor="#BABABA" android:startColor="#FAFAFA" android:type="linear" />

            <stroke android:width="0dp" android:color="#878787" />

            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape></item>
    <item android:state_pressed="true"><shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
            <corners android:radius="20dp" />

            <gradient android:angle="270" android:centerColor="#FF8000" android:centerX="50%" android:endColor="#FF8000" android:startColor="#FF8000" android:type="linear" />

            <stroke android:width="0dp" android:color="#878787" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape></item>

</selector>